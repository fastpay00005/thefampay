# ==========================================
# The FamPay Client Environment Configuration
# ==========================================

# Application Brand Identity
VITE_APP_NAME="The FamPay"

# Backend API Base URL (Leave blank for same-origin /api proxy, or set to your deployed backend URL on Vercel/Render)
VITE_API_BASE_URL=""

# Supabase Public Anonymous Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_public_key"

# Live Rates & Exchange Market Defaults
VITE_TOKEN_BUY_PRICE="100"
VITE_TOKEN_SELL_PRICE="98"
VITE_USDT_INR_RATE="88.50"
VITE_EXTRA_BONUS_PERCENT="2"
