# ==========================================
# The FamPay Server Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Brevo (Sendinblue) Transactional OTP Email Engine
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=support@thefampay.com
SENDER_NAME=The FamPay

# Supabase Realtime Database & Storage Engine
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Admin Authentication Token (Required for /api/admin/* endpoints)
ADMIN_SECRET_TOKEN=FAMPAY_SECURE_ADMIN_TOKEN_PROD_2026
